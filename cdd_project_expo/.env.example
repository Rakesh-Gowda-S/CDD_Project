POSTGRES_DB=campus_lost_found
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://campus_user:change-this-local-password@localhost:5432/campus_lost_found?schema=public
PGADMIN_DEFAULT_EMAIL=admin@campus.edu
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Create administrators with `npm run create-admin` using temporary ADMIN_NAME,
# ADMIN_EMAIL, and ADMIN_PASSWORD variables. Do not store bootstrap credentials here.
