generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  LOST
  FOUND
  RESOLVED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
}

enum ListingReportReason {
  INAPPROPRIATE
  MISLEADING
  SPAM
  OTHER
}

enum ListingReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(STUDENT)
  approvalStatus ApprovalStatus @default(APPROVED)
  approvalDecidedAt DateTime?
  approvalDecidedBy String?  @db.ObjectId
  accountStatus UserAccountStatus @default(ACTIVE)
  listings     Listing[]
  messages     Message[]
  reports      ListingReport[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Listing {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  status       ListingStatus
  category     String
  approximateDate DateTime
  location     String
  imagePath    String?
  isResolved   Boolean       @default(false)
  expiresAt    DateTime?
  archivedAt   DateTime?
  ownerId      String        @db.ObjectId
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages     Message[]
  reports      ListingReport[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, category, location])
  @@index([createdAt])
}

model ListingCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampusLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListingReport {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  listingId       String              @db.ObjectId
  reporterId      String              @db.ObjectId
  reason          ListingReportReason
  details         String?
  status          ListingReportStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?             @db.ObjectId
  createdAt       DateTime            @default(now())
  listing         Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter        User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
}

model PortalSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  key                String   @unique @default("portal")
  listingLifetimeDays Int     @default(90)
  updatedAt          DateTime @updatedAt
}

model AdminActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String   @db.ObjectId
  adminName String
  action    String
  targetType String
  targetId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  senderId  String   @db.ObjectId
  listingId String   @db.ObjectId
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([senderId, createdAt])
}
